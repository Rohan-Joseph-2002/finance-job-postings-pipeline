# Python
__pycache__/
*.py[cod]

# Virtual environment
.venv/

# Environment / secrets
.env
*.key
*.pem

# OS
.DS_Store

# Tooling caches
.ruff_cache/
.pytest_cache/

# Generated outputs (keep the folder tree via .gitkeep)
/output/**
!/output/
!/output/**/
!/output/**/.gitkeep

# Logs (keep the folder)
/logs/*
!/logs/.gitkeep

# Input data: ignore real inputs, keep committed samples
/input/*
!/input/.gitkeep
!/input/*sample*
